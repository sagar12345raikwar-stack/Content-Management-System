pipeline {
    agent none

    environment {
        LOG_DIR = "/tmp/jenkins-logs"
    }

    stages {

        stage('Checkout') {
            agent { label 'agent-1' }
            steps {
                git url: 'git@github.com:sagar12345raikwar-stack/Content-Management-System.git', branch: 'branch-1'
            }
        }

        stage('Build') {
            agent { label 'agent-2' }
            steps {
                sh 'echo "Build running on agent-2"'
            }
        }

        stage('Test') {
            agent { label 'agent-1' }
            steps {
                sh 'exit 1'
            }
        }
    }

    post {

        failure {
            node('agent-1') {
                echo "Build Failed!"
                sh 'echo "ALERT: Build failed!"'
                sh '''
                    mkdir -p $LOG_DIR
                    echo "Failure log" > $LOG_DIR/failure.log
                '''
            }
        }

        always {
            node('agent-1') {
                cleanWs()
            }
        }
    }
}
